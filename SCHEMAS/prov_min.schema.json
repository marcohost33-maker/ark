{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://prov_min.schema.json",
  "type": "object",
  "required": [
    "entities",
    "activities",
    "agents",
    "edges"
  ],
  "additionalProperties": false,
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "location_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "start_utc": {
            "type": [
              "string",
              "null"
            ]
          },
          "end_utc": {
            "type": [
              "string",
              "null"
            ]
          },
          "tool_version": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "src",
          "dst"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "wasGeneratedBy",
              "used",
              "wasAssociatedWith",
              "wasDerivedFrom"
            ]
          },
          "src": {
            "type": "string",
            "minLength": 1
          },
          "dst": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
