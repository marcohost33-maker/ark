{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://report_evidence_profile.schema.json",
  "type": "object",
  "required": [
    "run_id",
    "status",
    "items",
    "created_utc"
  ],
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "ACCEPT",
        "ACCEPT_WITH_NOTES",
        "REVIEW",
        "REJECT"
      ]
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gate_id",
          "summary",
          "evidence_refs"
        ],
        "additionalProperties": false,
        "properties": {
          "gate_id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "neg_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
